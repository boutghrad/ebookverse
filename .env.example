# Database (PostgreSQL - required for Vercel deployment)
# For Neon: https://neon.tech  |  For Supabase: https://supabase.com
# Example: postgresql://user:password@host/database?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/ebookverse?schema=public"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Email (Resend - https://resend.com)
# Free plan: 100 emails/day
RESEND_API_KEY=re_xxxxxxxxxxxx

# Run: npx prisma db push && npx tsx prisma/seed.ts to set up the database
